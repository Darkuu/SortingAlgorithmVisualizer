<Window x:Class="SortingVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorting Visualizer"
        Width="1150"
        Height="650"
        MinWidth="400"
        MinHeight="350"
        Background="#181818">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sorting, playback, and sound -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">

            <ComboBox x:Name="AlgorithmBox"
                      Width="150"
                      SelectedIndex="0"
                      Margin="0,0,12,8">
                <ComboBoxItem Content="Bubble Sort"/>
                <ComboBoxItem Content="Selection Sort"/>
                <ComboBoxItem Content="Insertion Sort"/>
                <ComboBoxItem Content="Merge Sort"/>
                <ComboBoxItem Content="Quick Sort"/>
            </ComboBox>

            <Button x:Name="ShuffleButton"
                    Content="Shuffle"
                    Width="75"
                    Margin="0,0,8,8"
                    Click="Shuffle_Click"/>

            <Button x:Name="StartButton"
                    Content="Start"
                    Width="75"
                    Margin="0,0,8,8"
                    Click="Start_Click"/>

            <Button x:Name="StopButton"
                    Content="Stop"
                    Width="75"
                    IsEnabled="False"
                    Margin="0,0,16,8"
                    Click="Stop_Click"/>

            <TextBlock Text="Step delay:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <Slider x:Name="DelaySlider"
                    Minimum="1"
                    Maximum="150"
                    Value="20"
                    Width="110"
                    VerticalAlignment="Center"
                    Margin="0,0,8,8"/>

            <TextBlock Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,16,8"
                       Text="{Binding ElementName=DelaySlider,
                                      Path=Value,
                                      StringFormat={}{0:F0} ms}"/>

            <CheckBox x:Name="SoundCheckBox"
                      Content="Sound"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="0,0,12,8"
                      Unchecked="SoundCheckBox_Unchecked"/>

            <ComboBox x:Name="WaveformBox"
                      Width="110"
                      Margin="0,0,12,8"
                      SelectionChanged="WaveformBox_SelectionChanged"/>

            <TextBlock Text="Pitch:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <Slider x:Name="PitchSlider"
                    Minimum="0.15"
                    Maximum="1.25"
                    Value="0.5"
                    Width="110"
                    VerticalAlignment="Center"
                    Margin="0,0,8,8"
                    ValueChanged="PitchSlider_ValueChanged"/>

            <TextBlock Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,16,8"
                       Text="{Binding ElementName=PitchSlider,
                                      Path=Value,
                                      StringFormat={}{0:F2}x}"/>

            <CheckBox x:Name="CompareCheckBox"
                      Content="Compare two"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="0,0,0,8"
                      Checked="CompareCheckBox_Checked"
                      Unchecked="CompareCheckBox_Unchecked"/>
        </WrapPanel>

        <!-- Bar count and colors -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">

            <TextBlock Text="Bars:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <TextBox x:Name="BarCountBox"
                     Text="80"
                     Width="65"
                     Margin="0,0,8,8"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="ApplyCountButton"
                    Content="Apply"
                    Width="65"
                    Margin="0,0,20,8"
                    Click="ApplyCount_Click"/>

            <TextBlock Text="Normal:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <ComboBox x:Name="NormalColorBox"
                      Width="115"
                      Margin="0,0,12,8"
                      SelectionChanged="Color_SelectionChanged"/>

            <TextBlock Text="Highlight 1:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <ComboBox x:Name="FirstColorBox"
                      Width="115"
                      Margin="0,0,12,8"
                      SelectionChanged="Color_SelectionChanged"/>

            <TextBlock Text="Highlight 2:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <ComboBox x:Name="SecondColorBox"
                      Width="115"
                      Margin="0,0,12,8"
                      SelectionChanged="Color_SelectionChanged"/>

            <TextBlock Text="Finished:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>

            <ComboBox x:Name="FinishedColorBox"
                      Width="115"
                      Margin="0,0,0,8"
                      SelectionChanged="Color_SelectionChanged"/>
        </WrapPanel>

        <Canvas x:Name="BarsCanvas"
                Grid.Row="2"
                Background="#222222"
                ClipToBounds="True"
                SizeChanged="BarsCanvas_SizeChanged"/>

        <!-- Status on the left, elapsed time on the right -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Margin="0,0,16,0"/>

            <TextBlock x:Name="ElapsedText"
                       Grid.Column="1"
                       Text="Time: 0.00 s"
                       Foreground="White"
                       VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>